# Copia este archivo como .env y completa los valores. El archivo .env no se sube a git.

# Obligatoria: clave de la cuenta del personal (mínimo 8 caracteres).
CAFETERIA_CLAVE_PERSONAL=

# Usuario de la cuenta del personal.
CAFETERIA_USUARIO_PERSONAL=personal

# Clave para firmar las cookies de sesión. Si se deja vacía se genera una al arrancar
# y las sesiones se cierran cada vez que se reinicia la aplicación.
CAFETERIA_SECRETO_SESION=

# Archivo de la base de datos SQLite.
CAFETERIA_BD=data/cafeteria.db

# Dominio permitido para el correo institucional de los clientes.
CAFETERIA_DOMINIO_CORREO=epn.edu.ec

# 1 carga el menú de demostración cuando la base de datos está vacía; 0 no lo carga.
CAFETERIA_CARGAR_SEMILLA=1

# Dirección y puerto del servidor en la ejecución local.
CAFETERIA_HOST=127.0.0.1
CAFETERIA_PUERTO=8000
